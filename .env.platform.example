# bands.finance platform layer (identity + personal agent + credits). Documentation only; these are
# read by src/platform/config.ts from the same .env as the agent. Every key has a default and the
# layer ships dormant: with none of these set, sign-in works with a per-boot secret, chat is
# refused with 503 "the advisor is not configured on this host", and no credits are charged.

# ---------- Sessions ----------
# 32+ random chars. Signs the sign-in challenge and the 7-day session bearer (src/platform/accounts.ts).
# Unset: a random per-boot secret is used and every restart signs everyone out.
BANDS_SESSION_SECRET=

# ---------- The advisor model ----------
# Also read by the trading loop (src/config.ts). Unset: /api/my-agent/message and /stream return 503.
ANTHROPIC_API_KEY=
# Model for users' personal advisors (the house agent uses MODEL). Sent with the persona as a cached system block.
USER_AGENT_MODEL=claude-sonnet-5
# Output ceiling per reply. Floored at 256 in code.
USER_AGENT_MAX_TOKENS=1536

# ---------- Spend ceilings (folded from data/turns.jsonl, never from a process counter) ----------
# Metered turns across all wallets in the trailing 24h. 0 closes chat entirely (the kill switch). 503 chat_daily_cap when hit.
CHAT_MAX_TURNS_PER_DAY=50000
# Per wallet in the trailing 24h. 429 wallet_daily_cap when hit.
CHAT_MAX_TURNS_PER_WALLET_PER_DAY=200

# ---------- Backpressure (in-memory, shape load only) ----------
# Simultaneous model turns; overflow waits CHAT_ACQUIRE_TIMEOUT_MS for a slot, then 503.
CHAT_CONCURRENCY=40
CHAT_ACQUIRE_TIMEOUT_MS=15000
# Per-wallet token bucket: burst, then +1 token every refill interval. 429 when empty.
CHAT_RATE_BURST=5
CHAT_RATE_REFILL_MS=3000
# A streamed turn with no event from the model for this long is aborted (no refund: the tokens were spent).
STREAM_IDLE_TIMEOUT_MS=120000
# Per-IP buckets on /api/* (keyed by route prefix) and, stricter, on /api/account/*. 429 with Retry-After: 5.
GLOBAL_RATE_PER_MIN=1800
AUTH_RATE_PER_MIN=30

# ---------- Credits (data/credits.jsonl) ----------
# Only the literal "true" (or "on") charges 1 credit per message. Default false: chat is free, but every turn is
# still metered in turns.jsonl and the signup grant is still written, so the ledger is real when this turns on.
CREDITS_ENFORCED=false
# The free grant every new wallet gets on its first balance read. A wallet with any history never gets it again.
CREDITS_FREE_MESSAGES=50

# ---------- Operator ----------
# Bearer for GET /api/platform/ops and POST /api/platform/credits/grant. Unset: those routes return 503 (fail closed).
PLATFORM_OPERATOR_TOKEN=

# ---------- Web (web/.env, read by Vite) ----------
# VITE_API_URL=https://api.bands.finance     where the platform API lives; unset = same origin, probed via /api/health
# VITE_RPC_URL=https://api.mainnet-beta.solana.com   the wallet adapter's connection endpoint
