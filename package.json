{
  "name": "mr-bands",
  "version": "1.0.0",
  "description": "Mr Bands: an LLM-driven Meteora DLMM liquidity agent with hard risk guards",
  "main": "index.js",
  "scripts": {
    "test": "tsx src/scripts/test-guards.ts",
    "read-pool": "tsx src/scripts/read-pool.ts",
    "once": "tsx src/index.ts --once",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "serve": "tsx src/server.ts",
    "seed-demo": "tsx src/scripts/seed-demo.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:snapshot": "tsx src/scripts/snapshot.ts",
    "live:publish": "tsx src/scripts/publish-live.ts",
    "lessons:recompute": "tsx src/scripts/lessons-recompute.ts",
    "record": "tsx src/scripts/record.ts",
    "web:deploy": "npm run web:snapshot && cd web && vercel deploy --prod --yes ${LIVE_FEED_URL:+--build-env VITE_LIVE_URL=$LIVE_FEED_URL}",
    "dash:deploy": "npm run web:snapshot && node web/scripts/deploy-dash.mjs",
    "flow": "if command -v caffeinate >/dev/null 2>&1; then exec caffeinate -is tsx src/scripts/flow.ts; else exec tsx src/scripts/flow.ts; fi",
    "test:flow": "tsx src/scripts/test-flow.ts",
    "test:seat-yield": "tsx src/scripts/test-seat-yield.ts",
    "test:learn": "tsx src/scripts/test-learn.ts",
    "test:fastwatch": "tsx src/scripts/test-fastwatch.ts",
    "test:account-flow": "tsx src/scripts/test-account-flow.ts",
    "test:openhermit": "tsx src/scripts/test-openhermit.ts",
    "live:preflight": "set -a && . ./ops/live.env && set +a && DRY_RUN=false tsx src/scripts/preflight.ts",
    "live:rehearse": "set -a && . ./ops/live.env && set +a && DRY_RUN=true KILL_SWITCH=false LIVE_FEED=false AUTO_DEPLOY=false tsx src/index.ts --once",
    "screen": "tsx src/scripts/screen.ts",
    "test:screener": "tsx src/scripts/test-screener.ts",
    "test:platform": "tsx src/scripts/test-platform.ts",
    "test:engine": "tsx src/scripts/test-engine.ts",
    "test:all": "npm test && npm run test:engine && npm run test:platform && npm run test:rails && npm run test:autodecide && npm run test:screener && npm run test:backpack && npm run test:hot && npm run test:paper && npm run test:venues && npm run test:stock && npm run test:watchlist && npm run test:launch && npm run test:pair && npm run test:pair-stock && npm run test:voice && npm run test:talk && npm run test:meme && npm run test:meteora-stocks && npm run test:pinned && npm run test:clawpump && npm run test:sim && npm run test:web-model && npm run test:flow && npm run test:seat-yield && npm run test:learn && npm run test:fastwatch && npm run test:account-flow && npm run test:openhermit && npm run test:openhermit-provision && npm run test:halts && npm run test:status && npm run test:record",
    "test:stock": "tsx src/scripts/test-stock.ts",
    "test:venues": "tsx src/scripts/test-venues.ts",
    "test:rails": "tsx src/scripts/test-rails.ts",
    "test:autodecide": "tsx src/scripts/test-autodecide.ts",
    "paper": "tsx src/scripts/paper.ts",
    "basis": "tsx src/scripts/basis.ts",
    "test:backpack": "tsx src/scripts/test-backpack.ts",
    "hot": "tsx src/scripts/hot.ts",
    "test:hot": "tsx src/scripts/test-hot.ts",
    "preflight": "tsx src/scripts/preflight.ts",
    "live": "npm run preflight && if command -v caffeinate >/dev/null 2>&1; then exec caffeinate -is tsx src/index.ts; else exec tsx src/index.ts; fi",
    "test:paper": "tsx src/scripts/test-paper.ts",
    "paper:report": "tsx src/scripts/paper-report.ts",
    "watchlist": "tsx src/scripts/watchlist.ts",
    "test:watchlist": "tsx src/scripts/test-watchlist.ts",
    "test:sim": "tsx src/scripts/test-sim.ts",
    "test:launch": "tsx src/scripts/test-launch.ts",
    "test:pair": "tsx src/scripts/test-pair.ts",
    "test:pair-stock": "tsx src/scripts/test-pair-stock.ts",
    "pair-stock": "tsx src/scripts/pair-stock.ts",
    "clawpump": "tsx src/scripts/clawpump.ts",
    "test:clawpump": "tsx src/scripts/test-clawpump.ts",
    "test:pinned": "tsx src/scripts/test-pinned.ts",
    "test:meme": "tsx src/scripts/test-meme.ts",
    "test:voice": "tsx src/scripts/test-voice.ts",
    "talk": "tsx src/scripts/talk.ts",
    "test:talk": "tsx src/scripts/test-talk.ts",
    "test:meteora-stocks": "tsx src/scripts/test-meteora-stocks.ts",
    "test:web-model": "tsx src/scripts/test-web-model.ts",
    "equity:backfill": "tsx src/scripts/backfill-equity.ts",
    "openhermit": "tsx src/scripts/openhermit.ts",
    "test:openhermit-provision": "tsx src/scripts/test-openhermit-provision.ts",
    "test:halts": "tsx src/scripts/test-halts.ts",
    "test:status": "tsx src/scripts/test-status.ts",
    "test:record": "tsx src/scripts/test-record.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@hono/node-server": "^2.1.1",
    "@meteora-ag/dlmm": "^1.9.14",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@raydium-io/raydium-sdk-v2": "^0.2.69-alpha",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@vercel/blob": "^2.8.0",
    "bn.js": "^5.2.5",
    "dotenv": "^17.4.2",
    "hono": "^4.13.7",
    "tweetnacl": "^1.0.3",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "private": "true"
}
