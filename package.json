    "test:stock": "tsx src/scripts/test-stock.ts",
    "test:venues": "tsx src/scripts/test-venues.ts",
    "test:rails": "tsx src/scripts/test-rails.ts",
    "paper": "tsx src/scripts/paper.ts",
    "basis": "tsx src/scripts/basis.ts",
    "test:backpack": "tsx src/scripts/test-backpack.ts",
    "hot": "tsx src/scripts/hot.ts",
    "test:hot": "tsx src/scripts/test-hot.ts",
    "preflight": "tsx src/scripts/preflight.ts",
    "live": "npm run preflight && tsx src/index.ts",
    "test:paper": "tsx src/scripts/test-paper.ts",
    "paper:report": "tsx src/scripts/paper-report.ts",
    "watchlist": "tsx src/scripts/watchlist.ts",
    "test:watchlist": "tsx src/scripts/test-watchlist.ts",
    "test:sim": "tsx src/scripts/test-sim.ts",
    "test:launch": "tsx src/scripts/test-launch.ts",
    "test:pair": "tsx src/scripts/test-pair.ts"
  },
