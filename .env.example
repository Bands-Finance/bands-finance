# ---------- RPC ----------
# Claim free Helius credits through the hackathon registration and paste the URL here.
# The public endpoint works for the read-only milestone but is rate limited.
RPC_URL=https://api.mainnet-beta.solana.com

# ---------- Hot wallet ----------
# Dedicated agent wallet with a SMALL amount of SOL. Keep the treasury elsewhere.
# Accepts a base58 secret key (Phantom export) or a JSON byte array (solana-keygen file contents).
# Leave empty for read-only / dry-run: an ephemeral throwaway key is generated at startup.
WALLET_SECRET_KEY=

# ---------- Anthropic ----------
ANTHROPIC_API_KEY=
MODEL=claude-opus-5

# ---------- The decider: who Mr Bands asks each cycle ----------
# anthropic: Claude directly (structured output, the persona as the system prompt). openhermit: Mr Bands'
# agent on the OpenHermit gateway (src/agent/openhermit.ts; the persona lives in his instructions there,
# his hands are this desk's MCP server registered on the gateway). policy: nobody, the desk policy alone.
# Unset keeps the old rule: anthropic when ANTHROPIC_API_KEY is set, else policy. Whatever answers, the
# reply walks the same road: exitAsk dropped, the policy advises on any move of money, the guards decide.
DECIDER=
# The gateway (docs/transport-protocol.md in the OpenHermit repo), the agent's id on it, and the bearer
# the desk posts with (the gateway's admin token, GATEWAY_ADMIN_TOKEN in ~/.openhermit/gateway/.env;
# never in git). No token = the backend is unavailable and the desk policy proposes, with a note saying so.
OPENHERMIT_GATEWAY_URL=http://127.0.0.1:4000
OPENHERMIT_AGENT_ID=mr-bands
OPENHERMIT_TOKEN=
# One deadline for the whole ask (opening the pool's session and waiting for the reply): on it, the desk
# policy proposes this cycle with "OpenHermit timed out". A cycle never waits on the gateway longer than this.
OPENHERMIT_TIMEOUT_MS=60000
# Who serves the agent's model, for `npm run openhermit -- provision` only: openrouter (the gateway's
# shared OPENROUTER_API_KEY) or anthropic (an ANTHROPIC_API_KEY the owner has given the agent on the
# gateway with `hermit config secrets set`; provision checks it is there and writes no key).
OPENHERMIT_PROVIDER=openrouter
# A model id to pin on the agent (provision only); unset = the newest Anthropic Claude of MODEL's family
# that OpenRouter offers, or MODEL itself at Anthropic.
OPENHERMIT_MODEL=

# ---------- Safety ----------
# Anything other than the literal string "false" keeps dry-run ON.
DRY_RUN=true

# ---------- Pools ----------
# Leave empty: Mr Bands screens every DLMM pool on chain and works the best SOL-quoted ones.
# Set a comma-separated list to pin pools he must always watch (e.g. ANSEM/SOL below).
# POOL_ADDRESS=6e7V9eegCHw997T72MxgwwJipZ6GJyZF8NvjkzT1rvpN
POOL_ADDRESS=

# ---------- Screener ----------
SCREEN_INTERVAL_SEC=900
SCREEN_ACTIVE_HOURS=24
SCREEN_MAX_LIVE=1500
SCREEN_MAX_POOLS=300
SCREEN_MIN_TVL_SOL=20
# how many pools Mr Bands works at once
# Venues besides Meteora (scanned through their public pool APIs; "none" keeps Meteora only).
SCREEN_VENUES=raydium-clmm,orca-whirlpool
SCREEN_RAYDIUM_MAX_PAGES=4
SCREEN_ORCA_MAX_PAGES=5
# Tokenized-stock mints beyond xStocks (mint[:TICKER], comma-separated) tagged as Backpack Securities.
STOCK_MINTS=
MAX_ACTIVE_POOLS=3
# push a site snapshot to Vercel after every screen
# After each screen, push a snapshot to Vercel, at most this often.
AUTO_DEPLOY=false
AUTO_DEPLOY_MIN_MINUTES=30

# ---------- Scheduler ----------
# Stop after N cycles (0 = run until stopped). Use it for bounded dry runs: MAX_CYCLES=12.
MAX_CYCLES=0
CYCLE_INTERVAL_SEC=300
DATA_DIR=data

# ---------- Hard risk limits (enforced in src/risk, the LLM cannot override) ----------
MAX_POSITION_SOL=0.5
MAX_TOTAL_EXPOSURE_SOL=1.0
GAS_RESERVE_SOL=0.1
STOP_LOSS_PCT=15
MAX_BIN_WIDTH=69
MAX_TX_PER_DAY=24
MIN_SECONDS_BETWEEN_ACTIONS=600
# a held memecoin seat makes way for a candidate this many times better on the seat (the stock lane uses METEORA_STOCK_ROTATE_FACTOR)
MEME_ROTATE_FACTOR=1.5
MAX_SLIPPAGE_PCT=1
MAX_PRICE_MOVE_PCT_PER_CYCLE=40

# ---------- Engine (src/engine: exit ladder, breakers, collect, skim) ----------
# A band must sit out of range this long before the LLM may REBALANCE/CLOSE it (anti-churn).
ENGINE_OUT_OF_RANGE_SEC=120
# A drop larger than this over the trailing 30 min blocks opens in that pool.
ENGINE_KNIFE_PCT=20
# Circuit breaker: today's loss limit is max(floor, 15% of working SOL); trips halt opens 4h, then 6h.
ENGINE_CIRCUIT_FLOOR_SOL=0.05
# Portfolio breaker: equity drawdown limit is max(floor, 15% of the day's high) on 3 marks -> flatten + 12h stand-down.
# Clear it with: npx tsx src/scripts/engine.ts clear-standdown   (also: status, clear-halt)
ENGINE_PORTFOLIO_FLOOR_SOL=0.15
# Claim fees when a band holds this much SOL-equivalent, or when fees above the floor have waited 2h.
ENGINE_COLLECT_MIN_SOL=0.005
ENGINE_COLLECT_FLOOR_SOL=0.001
ENGINE_COLLECT_MAX_PER_DAY=30   # claims per UTC day; 0 = no cap
# Sells: a sale is sized by quoting to what the market takes under the cap in one swap; the rest waits. A sweep waits for
# the next claim or re-lay; an exit sells what fits under the exit cap, then the rest at once up to the hard cap, else the
# rest is a residue sold on later cycles (exit cap for SWAP_RESIDUE_CYCLES attempts, then the hard cap for as long as it takes).
# Only SOL-quoted pools are capped.
# 0 on both caps = one swap whatever the impact; an exit cap of 0 = exits uncapped.
SWAP_IMPACT_SWEEP_PCT=1.5
SWAP_IMPACT_EXIT_PCT=3
SWAP_IMPACT_HARD_PCT=8
SWAP_RESIDUE_CYCLES=4
# Treasury skim: dormant unless ENGINE_SKIM=true AND TREASURY_ADDRESS is a valid pubkey.
# Sends 75% of realized fee gain since the last skim, only from SOL above FLOAT_TARGET + GAS_RESERVE.
ENGINE_SKIM=false
ENGINE_FLOAT_TARGET_SOL=1
TREASURY_ADDRESS=
# When set, the loaded key must derive to this pubkey: live refuses to start otherwise, dry-run warns.
EXPECTED_WALLET=

# ---------- Venues (src/venues: Meteora DLMM and Raydium CLMM adapters) ----------
# Venues the desk may observe and trade (the picker, the paper desk, dry-run). "none" keeps every venue off.
TRADABLE_VENUES=meteora-dlmm,raydium-clmm
# Venues the executor may BROADCAST on when DRY_RUN=false. A tradable venue off this list trades in
# paper and dry-run only: Raydium ships dormant until its transaction path has been simulated with a
# funded wallet; add it here to go live on it.
LIVE_VENUES=meteora-dlmm
# Compute-unit price for Raydium transactions (versioned, 600k CU limit); 0 = no priority fee.
PRIORITY_FEE_MICROLAMPORTS=0
# The book: "all" (default) or "stocks". BOOK=stocks seats tokenized-stock pools first (rows with a
# stock tag on a tradable venue, SOL/USDC-quoted, best fee/TVL first) and the desk policy treats
# them as worth a band without a hot row or a score; the basis and session rules still gate opens.
BOOK=all
# Liquidity floor for the stock book, in USD.
STOCK_MIN_LIQUIDITY_USD=250000

# ---------- Paper mode (src/paper: a virtual book traded against live prices, DRY_RUN only) ----------
# PAPER_SOL > 0 turns paper mode on: a virtual wallet and virtual bands, marked against the live pool
# every cycle, journaled like a real cycle. Refuses to start beside DRY_RUN=false.
#   PAPER_SOL=100 DATA_DIR=data-paper npm run once     then: DATA_DIR=data-paper npm run paper:report
PAPER_SOL=0
PAPER_USDC=0
# cost charged on every paper open (the deposit) and close (the token leg), in percent
PAPER_SLIPPAGE_PCT=0.3
# The desk policy (src/agent/policy.ts) proposes when no ANTHROPIC_API_KEY is set or the call fails:
# a quote-only band covering this much of price, in pools that are hot picks or score above the floor.
POLICY_COVER_PCT=5
# Stock pools are straddled instead (a BOTH band, half USDC half stock token, hedged short on Backpack):
# each side of the active bin covers this much of price, x the US session's width (pre/after 1.5, closed 2).
STOCK_COVER_PCT=1.5
# Paper hedge fills charge this maker fee in percent of the notional (Backpack perps).
PAPER_HEDGE_FEE_PCT=0.02
# A seat under this share of MAX_TOTAL_EXPOSURE_SOL is not worth its rent: the policy holds instead.
# A seat must earn at least this much a day (the pool's fees x our share of the band, halved) and
# must earn back its unrecoverable rent and swap fees inside this many hours, or the policy passes.
# A pool must trade at least this much in 24h before the desk will make a market in it.
# Band width. Fees accrue ONLY to the bin the price is in, so every extra bin is idle money: the band
# is sized from what the pool actually moved in the last hour, not a fixed percentage.
# half-width = POLICY_VOL_MULTIPLE x |last hour's move|, held inside [MIN, MAX] percent of price.
# Set POLICY_VOL_MULTIPLE=0 to go back to the fixed POLICY_COVER_PCT / STOCK_COVER_PCT.
POLICY_VOL_MULTIPLE=1
POLICY_MIN_COVER_PCT=0.15
POLICY_MAX_COVER_PCT=4
POLICY_MIN_VOLUME_24H_USD=250000
POLICY_MIN_SEAT_YIELD_PCT=0.4
POLICY_MAX_PAYBACK_HOURS=24
POLICY_MIN_SEAT_PCT=5
POLICY_MIN_SCORE=20

# ---------- Optional analytics ----------
# LP Agent open API (https://docs.lpagent.io). With a key, pool stats come from
# GET /pools/{pool}/info; without one, GeckoTerminal.s public API is used.
LPAGENT_API_URL=https://api.lpagent.io/open-api/v1
LPAGENT_API_KEY=

# ---------- Site ----------
# Identity shown on bands.finance. Run several agents with different ids into one journal.
AGENT_ID=mr-bands
AGENT_NAME=Mr Bands
# When set, `npm start` also serves the API + dashboard on this port (or run `npm run serve` alone).
SERVE_PORT=3000

# ---------- Platform: payment rails, MCP, engine skill (src/platform) ----------
# See .env.platform.example for sign-in, chat, credits and rate-limit keys.
# x402 in USDC on Solana. X402_TREASURY is the OWNER pubkey; the USDC associated token account is
# derived at boot. Neither set -> stub mode (local dev only, loud log, nothing recorded as revenue).
# Treasury set without X402_VERIFY -> every priced call is refused (fail closed). X402_VERIFY=self
# verifies the payment on chain (transfer to the treasury ATA, <= 15 min old, signed proof).
X402_TREASURY=
X402_VERIFY=
# Per-tool prices in USD; a tool priced 0 (or absent) is free.
PRICE_POOL_SNAPSHOT_USD=0.01
PRICE_SCREEN_USD=0.02
PRICE_POOL_SCORE_USD=0.05
PRICE_AGENT_THOUGHTS_USD=0
# Engine skill access (advise-then-approve: the API returns unsigned transactions, the user signs).
# Default closed. ENGINE_OPEN=true opens it to every signed-in wallet; or list pubkeys.
ENGINE_OPEN=false
ENGINE_ALLOWLIST=
# Operator bearer for proposal decisions, stranded-payment settlement and credit grants. Unset = closed.
# The same bearer is the house's own MCP credential: sent as Authorization on POST /mcp it serves
# the operator tool list and passes the x402 paywall on priced tools (Mr Bands on OpenHermit
# reasons through this server and must not pay himself). Register it as the header on the
# gateway's mcp_servers row; never commit it.
PLATFORM_OPERATOR_TOKEN=

# ---------- Backpack (src/tools/backpack.ts, src/basis, src/engine/hedge.ts) ----------
# Reference feed: Backpack's 24/7 US-stock perps (NVDA.US_USDC_PERP ...) price the xStock pools.
# Public endpoints need no key; `npx tsx src/scripts/basis.ts` writes data/basis.json (GET /api/basis).
# Refuse opens when |on-chain price / perp mid - 1| exceeds this many percent (the band would be arbitraged through).
BASIS_MAX_PCT=1.0
# Refuse opens this many minutes before the 09:30 ET open; the first 15 minutes after the open are always refused.
BASIS_PRE_OPEN_MIN=30
# Hedge desk (dormant). Base64 ed25519 key pair from backpack.exchange/settings/api-keys; read-only calls
# (balances, positions, open orders) work with just these. Orders are placed or cancelled ONLY when
# HEDGE_LIVE=true AND DRY_RUN=false; anything else and the client refuses.
BACKPACK_API_KEY=
BACKPACK_API_SECRET=
HEDGE_LIVE=false
# Cap on the perp short's notional in USD; 0 = hedging off (the plan never emits an order).
HEDGE_MAX_NOTIONAL_USD=0
# Rebalance the hedge only when the inventory delta is worth at least this many USD.
HEDGE_MIN_REBALANCE_USD=25
# In PAPER mode the hedge is virtual and ON by default (a 0 cap means uncapped there): every stock-pool
# cycle "fills" the plan at the perp mid, marks it and accrues funding; the paper report nets it out.

# ---------- Jupiter (src/tools/jupiter.ts: the straddle's swap legs, free lite API, no key) ----------
# The acquire leg buys the token half before a BOTH deposit; a liquidating close sells the token back.
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
SWAP_SLIPPAGE_BPS=50
# Paper fills: the fee charged on the input (price impact ignored), in percent.
SWAP_FEE_PCT=0.1

# ---------- Hot watch (src/hot: the 2-minute surge loop beside the 15-minute screener) ----------
# Reads 5-minute and 1-hour volume from GeckoTerminal trending + DexScreener, computes fee yield per
# dollar of liquidity over the last hour, writes data/hot.json (GET /api/hot) and data/hot-history.jsonl.
HOT_INTERVAL_SEC=120
# pools under this much liquidity are dropped outright
HOT_MIN_LIQUIDITY_USD=20000
# pools younger than this are flagged "new" and kept off the tradable list
HOT_MIN_AGE_HOURS=12
# a pool crossing this daily fee/TVL pace with the last hour at 2x the day's pace is a SURGE
HOT_SURGE_DAILY_PCT=5
# rows kept in data/hot.json, best heat first
HOT_MAX_ROWS=60
# how many of the screener's top rows get a short-window refresh each tick
HOT_BOARD_TOP=150
# cap on live Meteora fee reads per tick for trending pools that are not on the board
HOT_ONCHAIN_READS=8
# Sibling pools. Trending ranks POOLS, not tokens: WET trended in WET/PTN on Raydium ($3M in 24h, a
# quote the book cannot seat) while its WET/SOL pools on Meteora, which the desk could have quoted,
# never trended because they are smaller. So when a token turns up on trending (or high on the board)
# in a pool we cannot trade, the watch asks GeckoTerminal for that token's OTHER pools
# (GET /networks/solana/tokens/{mint}/pools) and lets the tradable ones into the same pipeline.
# Only for tokens whose untradable pool traded at least this much in 24h.
HOT_SIBLING_MIN_VOL_24H_USD=500000
# Lookups per tick, most promising token first (one HTTP call each, paced beside the trending calls,
# sharing their 429 backoff). Keep it small: at 10 a tick can spend a minute waiting out rate limits.
# 0 turns sibling discovery off.
HOT_SIBLING_LOOKUPS=6
# How long a token's pool list is reused before it is fetched again, in minutes. 0 means "do not
# reuse across ticks"; the list a tick pays for is always used by that tick. A FAILED lookup is
# remembered for 5 minutes whatever this says, so one broken mint cannot eat the budget every tick.
HOT_SIBLING_TTL_MIN=30
# The top PumpSwap pools by 24h volume (GeckoTerminal, 20 rows a page, one call a page): the biggest
# graduated pump.fun tokens, which the pair lane reads as REFERENCE pools. 0 turns the source off.
HOT_PUMPSWAP_PAGES=1

# ---------- Launch lane (src/screener/launch.ts: the one rule that admits a CATEGORY) ----------
# Everything else refuses a brand-new pool on purpose (the screener's `new` flag, HOT_MIN_AGE_HOURS,
# hotPicks, the watchlist in allow mode, POLICY_MIN_SCORE). That default is right, and it is also why
# the desk watched WET print $2.5M in its first two hours and entered nothing. The launch lane admits
# the SHAPE of a launch instead of a name, under harsher terms, so the trade cannot hurt the book.
# Anything but "true" (or unset) turns the whole lane off.
LAUNCH_LANE=true
# --- admission: every one of these must pass, and every refusal names the number that failed ---
# past this the pool is not a launch any more, it is judged as an ordinary pool
LAUNCH_MAX_AGE_HOURS=48
# nothing in its first half hour, whatever it prints
LAUNCH_MIN_AGE_MIN=30
# a band needs a bin with money in it. 15k admits the WET/SOL pool that motivated the lane (17k, 28x turnover)
LAUNCH_MIN_LIQUIDITY_USD=15000
# fees come from volume
LAUNCH_MIN_VOLUME_24H_USD=400000
# 24h volume / liquidity: the pool must trade its own book several times over
LAUNCH_MIN_TURNOVER=3
# the 24h figure must still be happening NOW, not an hour ago
LAUNCH_MIN_VOLUME_1H_USD=50000
# (also refused: two thirds of the last hour's trades are sells AND the hour is worse than -10%,
#  or the hot watch flags the pool `dumping`. The quote must be SOL or USDC.)
# --- the harsher terms a launch seat carries ---
# launch pools the picker may seat at once, after every ordinary pick has had its chance
LAUNCH_MAX_SEATS=1
# the seat is capped at this percent of MAX_TOTAL_EXPOSURE_SOL, on top of every other cap
LAUNCH_SEAT_PCT=10
# the per-band stop, rolled with the same jitter as STOP_LOSS_PCT and stored the same way
LAUNCH_STOP_PCT=8
# a launch band older than this is closed by the engine's EXPIRE directive (liquidating)
LAUNCH_MAX_HOLD_MIN=240
# ... and so is one whose pool's last hour falls under this, or under a third of what it was at open
LAUNCH_FADE_VOLUME_1H_USD=20000

# ---------- Stock pair lane (src/screener/pairStock.ts, src/venues/pair.ts: our own STOCKx/SOL pools on Meteora) ----------
# THE FOCUS (Zach: "focus on meteora pools initially and setting up different pools with our native token and
# tokenized stocks"). Every tokenized-stock pool on the board but one sits on Raydium or Orca, mostly USDC-quoted,
# so a SOL holder buys a stock through two pools (SOL -> USDC -> STOCKx). For each xStock the lane admits, the desk
# makes a STOCKx/SOL pool of its own on Meteora DLMM (the same pair venue and pair-<mint> key as the pump.fun lane;
# if a customizable pool for the pair already exists, the desk seats in it with its real parameters) and works a
# two-sided straddle in it (half SOL, half stock bought through Jupiter), hedged short on Backpack's perp where one
# is listed and said to be "unhedged" where none is. It is picked RIGHT AFTER held and pinned pools, before every
# ordinary lane. No launch-lane exits: the ordinary stop, the cost-based re-centre and the stock policy's own
# closes apply, plus one guard (the reference off the board). Anything but "true" (or unset) turns the lane off.
PAIR_STOCK_LANE=true
# the tickers the lane may make pools for, comma-separated ("SPY,NVDA" or "SPYx,NVDAx"); unset = every xStock on the board
PAIR_STOCK_TICKERS=
# --- admission: the ticker's pools on the board grouped by mint; the REFERENCE is its deepest pool by TVL on any venue ---
# the reference must hold this much
PAIR_STOCK_MIN_REF_LIQUIDITY_USD=100000
# the ticker's 24h volume, summed over its pools
PAIR_STOCK_MIN_VOLUME_24H_USD=500000
# (also refused: a reference flagged thin or no-24h-data, no reference price; a watchlist DENY wins; one pool per ticker.
#  Only xStocks (Backed; mints starting "Xs") are candidates; Backpack Securities mints are off the lane for now.)
# stock pools of ours holding a band at once
PAIR_STOCK_MAX_POOLS=3
# seats of MAX_ACTIVE_POOLS kept from ordinary picks while the lane holds fewer stock pools than this
PAIR_STOCK_RESERVE_SEATS=2
# --- the pool: STOCKx/SOL (the quote is always SOL) ---
# bin step in bps (20 = 0.2% per bin: equities move a percent or two a day)
PAIR_STOCK_BIN_STEP=20
# leave PAIR_STOCK_FEE_BPS unset and the lane picks the fee per pool from PAIR_STOCK_FEE_MENU by the stock routing model; set it to force one
#PAIR_STOCK_FEE_BPS=25
PAIR_STOCK_FEE_MENU=10,25,50
# "both" (default): fees collected in whichever token came in (a straddle earns both sides and the inventory is hedged); "quote": SOL only
PAIR_STOCK_COLLECT_FEE_MODE=both
# --- the seat: PAIR_STOCK_SEAT_PCT of MAX_TOTAL_EXPOSURE_SOL, half SOL half stock (bought SOL -> USDC -> STOCKx through Jupiter);
#     width from the stock straddle's sizing: STOCK_COVER_PCT x the US session's width multiplier, in bins of OUR bin step ---
PAIR_STOCK_SEAT_PCT=15
# --- the stock routing MODEL (a model, not a measurement): a SOL holder's cost through the reference is the SOL/USDC hop
#     (fee + impact on a deep pool; 0 when the reference is itself SOL-quoted) + the reference pool's fee (the board's,
#     else 0.25%) + impact, where a concentrated pool holds PAIR_REF_DEPTH_PER_PCT of its TVL within 1% of price
#     (impactPct = D / (TVL x PAIR_REF_DEPTH_PER_PCT)); ours is our fee + the walk across our bins, fillable to our depth.
#     Value-weighted over log-uniform trade sizes on [min, max] USD; the other SOL-quoted concentrated pools for the
#     ticker split the routed flow with us by depth. Fees/day = min(ticker vol24h, vol1h x 24) x share x our fee. ---
PAIR_STOCK_TRADE_MIN_USD=100
PAIR_STOCK_TRADE_MAX_USD=20000
PAIR_HOP_FEE_PCT=0.04
PAIR_REF_DEPTH_PER_PCT=0.10
# --- the lane's one exit of its own: the reference off the board for this many cycles marks the band at the last price and closes it (liquidating) ---
PAIR_STOCK_REF_GONE_CYCLES=3
# (live: the same create path and gate as the pump.fun lane: PAIR_LIVE=true, DRY_RUN=false and meteora-dlmm in LIVE_VENUES;
#  dry-run builds and simulates the create transaction and never sends it.)

# ---------- Pair lane (src/screener/pair.ts, src/venues/pair.ts: make our own pool for a pump.fun token) ----------
# A graduated pump.fun token trades on PumpSwap, a constant-product AMM, in TOKEN/SOL. Its depth is
# spread over every price ($50k of liquidity is ~$250 per 1% of move); a few thousand dollars
# concentrated in 1% bins at the price is far deeper in range, so Jupiter routes most trade sizes
# through our pool even at a higher fee, and a pool that is entirely ours pays us everything it
# earns. pump.fun tokens dump, and the concentrated liquidity absorbs the sells first: the lane
# inherits the launch lane's terms (capped seat, tighter stop, maximum hold, volume-fade EXPIRE)
# and works one pool at a time. Anything but "true" (or unset) turns the lane off.
PAIR_LANE=true
# --- admission: the REFERENCE (PumpSwap) pool's numbers; every refusal names the number that failed ---
PAIR_MIN_AGE_MIN=30
PAIR_MAX_AGE_HOURS=48
PAIR_MIN_REF_LIQUIDITY_USD=30000
PAIR_MIN_VOLUME_24H_USD=1000000
PAIR_MIN_VOLUME_1H_USD=100000
# 24h volume / reference liquidity
PAIR_MIN_TURNOVER=5
# (also refused: the launch lane's dumping rule, a missing reference price; a watchlist DENY wins.)
# Other pools never refuse: if a Meteora customizable pool for TOKEN/quote already exists (the program
# derives that address from the pair alone) the desk seats in it; other concentrated SOL/USDC pools
# for the mint only split the routed flow with us, by depth, in the routing model.
# pools of ours holding a band at once
PAIR_MAX_POOLS=1
# --- the pool: the program allows SOL or USDC as the quote ---
PAIR_QUOTE=SOL
# bin step in bps (100 = 1% per bin) and the base fee in bps
PAIR_BIN_STEP=100
# leave PAIR_FEE_BPS unset and the lane picks the fee per pool from PAIR_FEE_MENU by the routing model
# (a deep PumpSwap pool next to a small seat wants 25; a thin one lets a big seat charge 100); set it to force one
#PAIR_FEE_BPS=50
PAIR_FEE_MENU=25,50,100
# "quote": every fee is collected in the quote token (the SDK's CollectFeeMode.OnlyY); "both": in whichever token came in
PAIR_COLLECT_FEE_MODE=quote
# --- the seat: PAIR_SEAT_PCT of MAX_TOTAL_EXPOSURE_SOL, half quote half token (bought through Jupiter), this many bins each side ---
PAIR_SEAT_PCT=10
PAIR_BINS_EACH_SIDE=2
# keep one seat of MAX_ACTIVE_POOLS for the lane while it holds no pool (ordinary picks cannot fill the book against it)
PAIR_RESERVE_SEAT=true
# the per-band stop and the maximum hold (the fade floor is LAUNCH_FADE_VOLUME_1H_USD)
PAIR_STOP_PCT=10
PAIR_MAX_HOLD_MIN=240
# --- the routing model: log-uniform trade sizes on [min, max] USD, value-weighted; PumpSwap's fee ---
PAIR_TRADE_MIN_USD=50
PAIR_TRADE_MAX_USD=5000
PUMPSWAP_FEE_PCT=0.25
# --- THE HOUSE TOKEN: Zach's own launch (the AnsemHack Clawrena entry, launched on ClawPump -> pump.fun). A mint on this
#     list is ALWAYS admitted by the lane whatever its age, volume or liquidity (only a watchlist DENY refuses it), quoted
#     in PAIR_QUOTE, never counted against PAIR_MAX_POOLS, seated right after held and pinned pools, and carries NO
#     launch-style exits (no maximum hold, no volume-fade EXPIRE: the pool stays up; the ordinary stop and re-centre apply).
#     Its reference for the model is whatever row the hot watch or the board has for the mint (bonding curve, PumpSwap,
#     anything); with none the pool is still made once a price is known and the model reports share n/a (nothing accrues on
#     paper until a reference exists). Comma-separated mints; default none. ---
PAIR_HOUSE_MINTS=
# a house seat is this percent of MAX_TOTAL_EXPOSURE_SOL, half quote half token
PAIR_HOUSE_SEAT_PCT=10
# --- live: a pool creation is broadcast ONLY when PAIR_LIVE=true, DRY_RUN=false and meteora-dlmm is in LIVE_VENUES;
#     otherwise the create transaction is built, simulated where a key exists, and journaled as "would create ... and seat ..." ---
PAIR_LIVE=false

# --- ClawPump (the AnsemHack Clawrena entry, docs/clawrena.md) ---
# the Mr Bands agent on clawpump.tech (public earnings need only this)
CLAWPUMP_AGENT_ID=
# a cpk_ partner key from https://clawpump.tech/dashboard/api; server-side only, never in git or chat
CLAWPUMP_API_KEY=
# the token the desk launches through `npm run clawpump -- launch --confirm` (DRY_RUN=false, with Zach's go)
TOKEN_NAME=
TOKEN_SYMBOL=
# at least 20 characters
TOKEN_DESCRIPTION=
# an https URL
TOKEN_IMAGE_URL=
TOKEN_DEV_BUY_SOL=0
# the pump.fun creation pair: SOL (default), or a pair from ClawPump's catalogue by symbol, ticker or mint.
# The Clawrena entry is paired with NVDA: TOKEN_PUMP_PAIR=NVDAx (pump.fun already lists tokens against NVDAx)
TOKEN_PUMP_PAIR=SOL
# creator fee on a custom pair, 100-300 bps (not allowed on the SOL pair); unset = the catalogue's default
TOKEN_CREATOR_FEE_BPS=

# --- the stocks the agent is paired with (Meteora only) ---
# pinned tickers: the desk works each one's existing Meteora DLMM pool (SOL or USDC quoted, best by fee/TVL,
# found through DexScreener, fee read from the pool account) as a hedged straddle with the volume, score,
# thin, yield and payback floors waived; Meteora has none -> the stock pair lane makes our own
PAIR_STOCK_PINNED_TICKERS=
# when a pin cannot be seated because the book is full, one band makes room (off-Meteora first, then the
# slowest earner; never a pin, the house pool, or a band younger than this many minutes)
PIN_ROTATE_MIN_AGE_MIN=60
# the only DEXes a swap may route through, by Jupiter's labels; unset = any route. "Meteora DLMM" keeps
# every token-half buy and every liquidation on Meteora (paper swaps then pay at least the pool's own fee)
SWAP_DEXES=

# --- the memecoin floor (every lane that can seat a non-stock token: hot list, board, launch lane, pump.fun pair lane) ---
# not on launch: a token's pool must be at least this many hours old (0 = off). Replayed on 2026-09-15 this alone
# would have kept the desk out of GOOGL, HUHCAT, CAT, NIKE and OpenAI (-12.7 SOL of closed bands)
MEME_MIN_AGE_HOURS=24
# and worth a market: at least this market cap in USD (0 = off); unreported market caps are refused while it is on
MEME_MIN_MARKET_CAP_USD=1000000
# optional ceiling (unset = none)
MEME_MAX_MARKET_CAP_USD=
# a month of training data (Zach, 2026-09-15: "stick with stocks"; memecoins only "with a month of training data"):
# a memecoin pool needs this many daily candles with volume on GeckoTerminal before the desk enters (0 = off);
# strict: a pool whose history is not read yet, or could not be read, is refused
MEME_MIN_HISTORY_DAYS=30
MEME_HISTORY_TTL_HOURS=24
# pools read per cycle (GeckoTerminal allows about 30 calls a minute, shared with the rest of the desk)
MEME_HISTORY_LOOKUPS=4

# --- Mr Bands' talking layer (docs/mr-bands-agent.md, docs/talk.md): dormant until every X key below is set and X_LIVE=true ---
# the operator's X handle and Mr Bands' own; both required to post, OPERATOR_HANDLE required to approve personality changes
OPERATOR_HANDLE=
X_HANDLE=
# X API (OAuth 1.0a user context, POST /2/tweets); never logged
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# only the literal "true" posts
X_LIVE=
# yellow strap: price within this percent of the band's WIDTH from an edge
STRAP_EDGE_PCT=15
# "stacked" counts fee milestones; add "compound" once the desk reinvests fees into its bands
STRAP_STACKED_EVENTS=milestone
POSTS_PER_DAY=8
REPLIES_PER_HOUR=10
MAX_REPLIES_PER_ACCOUNT=3
MAX_BIT_USES_PER_WEEK=3
# where personality.json, the X drafts and the rate limiter live; its own folder keeps them apart from the desk's files
TALK_STATE_PATH=

# --- Meteora's tokenized stocks (meteora.ag RWA tab, src/screener/meteoraStocks.ts) ---
# reads Meteora's pool discovery API (category rwa): tags every stock mint for the screener, the fast watch and the
# basis feed (DATA_DIR/stock-mints.json), and works the busiest real Meteora DLMM stock pools. "false" turns it off
METEORA_STOCKS=
# issuers the lane may trade: xstocks, backpack, ondo (pre-IPO synthetics like prestocks and tessera are never traded)
METEORA_STOCK_ISSUERS=xstocks,backpack,ondo
# a pool needs this much depth; its volume floor is POLICY_MIN_VOLUME_24H_USD, so the picker and the policy agree
METEORA_STOCK_MIN_TVL_USD=20000
METEORA_STOCK_MAX_POOLS=3
METEORA_STOCK_REFRESH_MIN=15
