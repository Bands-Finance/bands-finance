<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mr Bands, running continuously as a PAPER desk: real pools, live prices, a pretend wallet of
  100 SOL + 10,000 USDC. Nothing is broadcast (DRY_RUN stays on and PAPER_SOL refuses to run
  with it off). After each screen the loop pushes a snapshot to bands.finance, at most every
  30 minutes, so the site shows what the desk is doing.

  Install:  cp ops/com.bands.mrbands.paper.plist ~/Library/LaunchAgents/
            launchctl load ~/Library/LaunchAgents/com.bands.mrbands.paper.plist
  Stop:     launchctl unload ~/Library/LaunchAgents/com.bands.mrbands.paper.plist
  Watch:    tail -f data-live/mrbands.log   ·  API: http://localhost:3100/api/journal
  Book:     DATA_DIR=data-live npm run paper:report
  Halt now: touch STOP   (blocks every new band; exits still run)
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.bands.mrbands.paper</string>
  <key>WorkingDirectory</key><string>/Users/zach/Bands.Finance/mr-bands</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/npm</string>
    <string>run</string>
    <string>live</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>120</integer>
  <key>StandardOutPath</key><string>/Users/zach/Bands.Finance/mr-bands/data-live/mrbands.log</string>
  <key>StandardErrorPath</key><string>/Users/zach/Bands.Finance/mr-bands/data-live/mrbands.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/usr/bin:/bin</string>
    <key>DATA_DIR</key><string>data-live</string>
    <key>DRY_RUN</key><string>true</string>
    <key>PAPER_SOL</key><string>100</string>
    <key>PAPER_USDC</key><string>10000</string>
    <key>BOOK</key><string>stocks</string>
    <key>LAUNCH_LANE</key><string>false</string>
    <key>PAIR_LANE</key><string>false</string>
    <key>MEME_MIN_AGE_HOURS</key><string>720</string>
    <key>MEME_MIN_HISTORY_DAYS</key><string>30</string>
    <!-- Venue focus (Zach, 2026-09-15): opens on Meteora DLMM only. Held Raydium bands keep being managed:
         discovery covers every adapter venue and the guards gate OPENS only. Six seats: three for the
         stock pair lane (PAIR_STOCK_MAX_POOLS, two reserved), one for the pump.fun pair lane, the rest ordinary. -->
    <key>TRADABLE_VENUES</key><string>meteora-dlmm</string>
    <key>MAX_ACTIVE_POOLS</key><string>6</string>
    <key>MAX_POSITION_SOL</key><string>44</string>
    <key>MAX_TOTAL_EXPOSURE_SOL</key><string>175</string>
    <key>GAS_RESERVE_SOL</key><string>1</string>
    <key>MAX_TX_PER_DAY</key><string>240</string>
    <key>CYCLE_INTERVAL_SEC</key><string>300</string>
    <key>SCREEN_INTERVAL_SEC</key><string>1800</string>
    <key>AUTO_DEPLOY</key><string>true</string>
    <key>AUTO_DEPLOY_MIN_MINUTES</key><string>30</string>
    <key>HEDGE_MIN_REBALANCE_USD</key><string>5</string>
    <key>PAIR_SEAT_PCT</key><string>20</string>
    <key>PAIR_QUOTE</key><string>USDC</string>
    <key>PAIR_STOCK_LANE</key>
    <string>false</string>
    <key>METEORA_STOCK_MAX_POOLS</key>
    <string>5</string>
    <key>PAIR_STOCK_PINNED_TICKERS</key><string>NVDA</string>
    <key>SWAP_DEXES</key><string>Meteora DLMM</string>
    <key>SERVE_PORT</key><string>3100</string>
    <!-- Outside proposals approved by the desk's own rules (src/platform/autoDecide.ts), no operator in the loop:
         a small SOL-only open from a signed-in wallet (or an mcp:b: id on AUTO_APPROVE_PROPOSERS), never a claimed name
         and never a close, asked of the desk policy before it is approved, within a
         daily and exposure budget; the desk policy and every guard still decide. Paper only: a live book also needs
         AUTO_APPROVE_LIVE=true and an AUTO_APPROVE_PROPOSERS allowlist, and ops/live.env sets neither. -->
    <key>AUTO_APPROVE_PROPOSALS</key><string>true</string>
    <!-- Mr Bands on OpenHermit (docs/openhermit.md): uncomment to have the agent on the gateway propose instead of
         the desk policy (the guards still decide; an unusable answer falls back to the desk policy). First put
         OPENHERMIT_TOKEN and PLATFORM_HOUSE_TOKEN in .env, then run the openhermit script's provision command for the
         paper MCP, then its ask command (both spelled out in docs/openhermit.md). Switch back with DECIDER=policy, then
         bootout and bootstrap this service. (No double hyphens in this comment: they are not legal inside XML comments.)
    <key>DECIDER</key><string>openhermit</string>
    <key>OPENHERMIT_GATEWAY_URL</key><string>http://127.0.0.1:4000</string>
    <key>OPENHERMIT_AGENT_ID</key><string>mr-bands</string>
    <key>OPENHERMIT_TIMEOUT_MS</key><string>60000</string>
    -->
  </dict>
</dict>
</plist>
