# Mr Bands LIVE, sized for the first 20 SOL (2026-09-17). Non-secret; the wallet key stays in .env.
# Loaded by ops/com.bands.mrbands.live.plist and by `npm run live:preflight` / `npm run live:rehearse`.
# DRY_RUN is deliberately NOT here: the live service sets it, and only when Zach says go.

# The halt. The live desk stays halted (no new bands; exits and claims still run) until Zach clears this line
# at the go step (docs/live.md). It lives here and not as data-mainnet/STOP so archiving the data directory
# cannot lift it. `npm run live:rehearse` overrides it to false for its one dry-run cycle; live:preflight does not.
KILL_SWITCH=true
# Who proposes on the live desk: the desk policy, as on the first run. .env says DECIDER=openhermit for the paper
# desk, and this file is sourced before dotenv (which never overrides), so this line is what keeps that off real
# money. Changing it is Zach's call, made here and deliberately; see the OpenHermit section at the bottom.
DECIDER=policy

DATA_DIR=data-mainnet
PAPER_SOL=0
PAPER_USDC=0
POLICY_LIVE=true

# the book (Zach, 2026-09-17 12:30Z: "lets just enter memecoin style pools"): the board's best, memecoins included
BOOK=all
METEORA_STOCKS=false
METEORA_STOCK_MAX_POOLS=2
# depth and volume floors are sanity only: the seat-yield ranking decides (DKNG/SOL: $2.1M a day on $8k of depth)
METEORA_STOCK_MIN_TVL_USD=5000
POLICY_MIN_VOLUME_24H_USD=250000
# no pin: the book follows the yield ranking (the NVDA pairing was for the hackathon story, not the money)
PAIR_STOCK_PINNED_TICKERS=
# a seat is worth taking at 1% a day on itself (src/screener/seatYield.ts); a held seat makes way for one METEORA_STOCK_ROTATE_FACTOR times better (the stock lane, off while METEORA_STOCKS=false)
METEORA_STOCK_MIN_SEAT_YIELD_PCT=1
METEORA_STOCK_ROTATE_FACTOR=3
# a memecoin seat makes way for a candidate 1.5x better (the stock lane's 3x is never reached at 50-150%/day seats)
MEME_ROTATE_FACTOR=1.5
METEORA_STOCK_RANK_TOP=8
# only a pool that clearly pays: the seat must read 40%/day on the scout's measured flow before it is taken (was 2)
POLICY_MIN_SEAT_YIELD_PCT=40
# band width follows the token's own measured travel (the scout's last hour of swaps): 0.75x of it, up to
# 25% each way. Zach (2026-09-17): "thats where the money always is. Its in stable price action" (baton was
# laid 5 bins wide under the old 4% cap and priced out in minutes on a token moving 24 bins an hour)
POLICY_VOL_MULTIPLE=0.75
POLICY_MAX_COVER_PCT=25
# a memecoin band is not laid or re-laid while the price travelled more than this in the last hour: a token in flight runs
# through any band (TACZ, 47%/h, went through a 24% band); the desk holds SOL and waits for idle volume
POLICY_MAX_TRAVEL_PCT=30
# never narrower than 3% of price: a quiet hour must not put a whole seat into one or two bins
# Zach, 18 Sep ("make sure we are in idle volume"): no 3% bands on memecoins; every band that lost was narrower than the
# token's ordinary hourly move (ZCAT 3%, PURR 6%), every seat that made money held 20-25%
POLICY_MIN_COVER_PCT=10
# entry needs an hour of the scout's reading (ALLINU/SOL was opened on 18 minutes labelled an hour)
POLICY_MIN_FLOW_COVER_MIN=60
# an idle band is all SOL: following the price up needs no swap, so it waits two cycles, not 30 to 75 minutes
# Zach, 18 Sep: follow the price faster; the fast watch wakes the cycle the moment this wait runs out (idle-due)
POLICY_IDLE_RELAY_SEC=120
# our liquidity is at most a quarter of a band's depth with ours in it (baton/SOL was 36% of the bid side of a $62k pool),
# and a pool travelling more than 15% an hour gets a proportionally smaller seat, never under a third of the max band
POLICY_MAX_SIDE_SHARE_PCT=25
POLICY_SIZE_REF_TRAVEL_PCT=15
# with 5 SOL seats the fast movers keep 2.5 SOL (0.5 x 5), what they had at 0.33 x 7.5
POLICY_SIZE_MIN_MULTIPLE=0.5
# a board pool is seated on the flow scout's own reading of it, never on the venue's day figure; a held
# seat whose measured flow reads under half the floor for three cycles comes off (SEAT_FADE_FACTOR, SEAT_FADE_CYCLES)
POLICY_REQUIRE_FLOW=true
SEAT_FADE_FACTOR=0.5
SEAT_FADE_CYCLES=3
PAIR_STOCK_LANE=false
PAIR_LANE=false
LAUNCH_LANE=false
# memecoin floors: 30 days old with 30 days of candles (the paper desk's), at least $1M of market cap. 22 Sep: the 72h floor
# of 17 Sep admitted pools that dumped 30%+ inside 24h in 27.5% of windows (0% at 30 days), in both halves of the tape
MEME_MIN_AGE_HOURS=720
MEME_MIN_HISTORY_DAYS=30
MEME_MIN_MARKET_CAP_USD=1000000
TRADABLE_VENUES=meteora-dlmm
LIVE_VENUES=meteora-dlmm
# Zach, 18 Sep: sells route across every venue Jupiter knows, not only Meteora DLMM (the day-one restriction from the
# stock-pairing lane sent every exit into the same thin pool the desk had just left: 0.94 SOL of impact on 18 Sep alone)
SWAP_DEXES=

# size: 20 SOL in the wallet -> 15 at work as two memecoin seats of 7.5 (one token gapping cannot take
# the whole book; the 15% stop is per band), 1.5 kept for gas and rent
# Zach, 18 Sep: three seats of 5 SOL (one bad band is a third of the book, not half); the rotation and cooldown knobs below go with it
# Zach, 18 Sep 15:10Z: "really focus here and only enter 1 pool at a time thats highly profitable": one seat, the book in it
MAX_ACTIVE_POOLS=1
MAX_POSITION_SOL=10
MAX_TOTAL_EXPOSURE_SOL=15
GAS_RESERVE_SOL=1.5
STOP_LOSS_PCT=15
# claims count as actions and a busy memecoin book claims every few minutes: 120 bound by mid-afternoon on two seats
MAX_TX_PER_DAY=400
# one band move per pool every 180 s (was the 600 s default); the anti-churn wait for a free re-lay is ENGINE_OUT_OF_RANGE_SEC (120)
MIN_SECONDS_BETWEEN_ACTIONS=180
PIN_ROTATE_MIN_AGE_MIN=60

# pace
CYCLE_INTERVAL_SEC=300
SCREEN_INTERVAL_SEC=1800

# hedging stays off until Backpack keys exist
HEDGE_LIVE=false

# the sites: the live desk publishes its own journal, at most every 30 minutes
AUTO_DEPLOY=true
AUTO_DEPLOY_MIN_MINUTES=30
# the book the sites show as "now" (src/publish/snapshot.ts): the real one, and only this desk sets it; every other shell
# snapshots none. A real book whose newest decision is over 2 h old still ships as none (a finished run is not "now").
SNAPSHOT_BOOK=real
SERVE_PORT=3101

# the exit list, kept by hand: a held band on it comes off (closed and liquidated), one per cycle, and a listed pool is not
# picked again while listed. Empty since 2026-09-17 12:39Z, when the two stock seats were out.
ROTATE_OUT_POOLS=

# self-learning (src/learn/lessons.ts): every closed seat is a lesson (data-mainnet/lessons.jsonl); the tuner moves the band
# width multiple one step at a time from the recent lessons and the policy reads it live from this file
# TUNING_FILE is gone: width tuning is read only when LEARN_WIDTH_TUNING is the literal "true" (docs/learning.md).


# the fast watch (src/engine/fastwatch.ts): between cycles the loop reads the scout's last bin for held bands every 15 s
# and starts the cycle at once when a band is left or a stop is near; it never trades by itself
FAST_WATCH_SEC=15
FAST_MIN_GAP_SEC=90
FAST_MAX_PER_HOUR=20
# a quote-only book sells the base tokens its fee claims pay (and a liquidation takes the wallet's with it)
SWEEP_FEE_TOKENS=true
SWEEP_MIN_SOL=0.05


# the live feed (src/publish/live.ts): one JSON file uploaded to a public Vercel Blob store after every cycle; both sites
# poll it (VITE_LIVE_URL is baked in at deploy from this URL). The store's write token is BLOB_READ_WRITE_TOKEN in .env.
LIVE_FEED=true
LIVE_FEED_URL=https://j8hghfydpxfm7hfb.public.blob.vercel-storage.com/live.json

# Fee claims: no daily cap (Zach, 17 Sep: the fees are small and frequent; the old cap of 30 stopped claims at 17:18Z with 1.2 SOL unclaimed)
ENGINE_COLLECT_MAX_PER_DAY=0

# Sells (Zach, 18 Sep): a sale is sized by quoting to what the market takes under the cap in ONE swap; the rest waits.
# A sweep of fee tokens waits for the next claim or re-lay. An exit sells what fits under 3%, then the rest at once if that
# costs no more than 8%, else the rest is a residue sold on later cycles (3% for 4 attempts, then 8% for as long as it takes).
# Only SOL-quoted pools are capped: a residue is sold into SOL. Sweeps of fee tokens leave what does not fit for the next claim.
# 0 on both caps = one swap whatever the impact (the old behaviour); an exit cap of 0 = exits uncapped.
SWAP_IMPACT_SWEEP_PCT=1.5
SWAP_IMPACT_EXIT_PCT=3
SWAP_IMPACT_HARD_PCT=8
SWAP_RESIDUE_CYCLES=4

# The ask exit (Zach, 18 Sep 15:35Z, "lets change #2": on 18 Sep the desk sold 38.5 SOL of token at the mark and got 37.1,
# about 1.04 SOL of it the pools' own 2-3% swap fee). A close that would sell the token lays it instead as a TOKEN-only ask
# band from the active bin 3% up (src/engine/askExit.ts): traders buy it from us and the fee is ours. Not a seat (the picker
# may seat another pool beside it), but exposure. The ask follows the price down after 180 s (a re-lay, no sale); it is closed
# the moment it sells out. Two backstops fall back to the sale above: the chain 10% under the mark its first ask was laid at
# (its own rolled stop), or 4 hours on the book. Token worth under 0.2 SOL is sold as before (not worth a position).
# Fee-token sweeps and residues still sell. Never under the kill switch, a stand-down, or for a launch band.
EXIT_ASK=true
EXIT_ASK_COVER_PCT=3
EXIT_ASK_MIN_SOL=0.2
EXIT_ASK_STOP_PCT=10
EXIT_ASK_MAX_MIN=240
EXIT_ASK_RELAY_SEC=180

# --- the Clawrena token, $BANDS (decided by Zach, 2026-09-22; docs/sprint.md "The token", the steps in docs/token.md) ---
# The token IS the entry. Deadline to register AND tokenise: 1 October 2026, 24:00 EST (UTC-5), which is
# 2 October 05:00 UTC; the page's own schema.org endDate reads 2026-10-02T00:00:00-05:00.
# What it is: his own token, a key that will open the engine on your own wallet (once the hold gate ships), not a share. It pays holders nothing:
# no buyback, no burn, no revenue share, no holder rewards, no airdrop. The desk never holds, swaps or market-makes it (H1,
# src/risk/house.ts), and PAIR_HOUSE_MINTS stays unset through 8 Oct.
# LAUNCH PATH (Zach, 22 Sep, superseding the self-funded plan): ClawPump's MCP, launch_metaplex_genesis_token, for his
# ClawPump agent, paid from its custodial wallet; 75% of creator fees stay in ClawPump's custody for that agent, and the
# pair and buyback are ClawPump's defaults. He launches it himself through the launch bridge, armed by Zach
# (docs/launch.md). The bridge pins TOKEN_DESCRIPTION below byte for byte (src/launch/spec.ts; test:token-bridge
# holds the two together). Its ClawPump key lives in ~/.mrbands/clawpump.env, never here and never in .env.
# The TOKEN_* lines below also feed the superseded self-funded CLI (npm run clawpump), which is not run: the MCP
# launch sends no website and no TOKEN_IMAGE_URL (that one is on the site's domain).
TOKEN_NAME="Mr Bands"
# The ticker is BANDS (Zach, 22 Sep, over MRBANDS). A copycat "Mr Bands" $BANDS already trades on pump.fun with his
# portrait (mint JAARLUawF9DTauc9pHUyYpga8mDU3172cY7NzLfhpJ6m, NOT his), and "Blue Bands" uses BANDS too. Same name,
# same ticker: the MINT is the only difference, so his mint leads on every surface once it exists. The token is NOT
# linked to the website yet (Zach, 22 Sep): the description names no site, and TOKEN_ON_SITE below keeps it off both.
TOKEN_SYMBOL=BANDS
TOKEN_DESCRIPTION="Mr Bands is an autonomous AI market maker on Solana. He provides liquidity on Meteora and learns from every trade. His own token, not a share: it pays holders nothing."
TOKEN_IMAGE_URL=https://mrbands.finance/token-bands.png
# The standard SOL pair (22 Sep), replacing the 20 Sep spec of an NVDAx pair at 300 bps with a 2.5 SOL dev buy to
# the hot wallet. That was the costliest and riskiest option: a dev bag a stop could sell, US-person and
# issuer-freeze exposure through NVDAx, and the maximum fee holding volume down. pump.fun sets no creator fee on
# the SOL pair, so TOKEN_CREATOR_FEE_BPS is not set here (tokenSpec refuses one on SOL).
TOKEN_PUMP_PAIR=SOL
# No dev buy (22 Sep): nobody, us included, starts with a bag. The pair and the fee are fixed for good at launch.
TOKEN_DEV_BUY_SOL=0
# Two more, both set in .env and NOT here: this file is sourced before dotenv, which never overrides, so an empty
# line here would hide the .env value from the live desk.
#   TOKEN_PAYER_EXPECTED  his operating wallet's address (the public key only); the launch refuses without it
#   TOKEN_MINT            the mint, once launched: H1 and the talk lint read it, on the paper desk and the live one

# --- the entry's two outside pages, baked into the dashboard at deploy (web/scripts/deploy-dash.mjs -> VITE_TOKEN_URL / VITE_X_URL) ---
# Empty until they exist: the "For hire" chapter then says the token is coming and links nothing. Fill in the ClawPump token
# page the day of the launch and Mr Bands' X account once the announcement is posted; the next deploy prints the links.
TOKEN_URL=
# The token stays off the site until this reads true (Zach, 22 Sep: "I dont want to link our clawpump token to the
# website just yet"). Off, the chapter prints no $BANDS paragraph and no ClawPump link, even with TOKEN_URL filled in.
TOKEN_ON_SITE=false
X_URL=https://x.com/MrBandsSol

# --- Mr Bands on OpenHermit (docs/openhermit.md): commented out until Zach switches the live desk to the agent ---
# To switch, change DECIDER=policy at the top of this file to DECIDER=openhermit (one DECIDER line only: a second one
# further down would quietly win). The agent on the gateway is then asked instead of the policy; an unusable answer falls
# back to the desk policy (POLICY_LIVE=true above still governs whether the policy may open on a live book). Provision him
# from THIS environment first (`set -a; . ops/live.env; set +a; npm run openhermit -- provision --mcp live`) so his rules
# carry these limits. OPENHERMIT_TOKEN and PLATFORM_OPERATOR_TOKEN are secrets and stay in .env. DECIDER=policy switches back.
# OPENHERMIT_GATEWAY_URL=http://127.0.0.1:4000
# OPENHERMIT_AGENT_ID=mr-bands
# OPENHERMIT_TIMEOUT_MS=60000
