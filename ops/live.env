# Mr Bands LIVE, sized for the first 20 SOL (2026-09-17). Non-secret; the wallet key stays in .env.
# Loaded by ops/com.bands.mrbands.live.plist and by `npm run live:preflight` / `npm run live:rehearse`.
# DRY_RUN is deliberately NOT here: the live service sets it, and only when Zach says go.

DATA_DIR=data-mainnet
PAPER_SOL=0
PAPER_USDC=0
POLICY_LIVE=true

# the book: Meteora stock pools that already trade, plus the NVDA pairing; no pools of our own, no memecoins
BOOK=stocks
METEORA_STOCKS=true
METEORA_STOCK_MAX_POOLS=3
METEORA_STOCK_MIN_TVL_USD=20000
PAIR_STOCK_PINNED_TICKERS=NVDA
# a seat is worth taking at 1% a day on itself (src/screener/seatYield.ts); a held seat under that makes way for one 2x better
METEORA_STOCK_MIN_SEAT_YIELD_PCT=1
METEORA_STOCK_ROTATE_FACTOR=2
METEORA_STOCK_RANK_TOP=8
POLICY_MIN_SEAT_YIELD_PCT=1
PAIR_STOCK_LANE=false
PAIR_LANE=false
LAUNCH_LANE=false
MEME_MIN_AGE_HOURS=720
MEME_MIN_HISTORY_DAYS=30
TRADABLE_VENUES=meteora-dlmm
LIVE_VENUES=meteora-dlmm
SWAP_DEXES="Meteora DLMM"

# size: 20 SOL in the wallet -> 15 at work across 3 bands of 5, 1.5 kept for gas and rent
MAX_ACTIVE_POOLS=3
MAX_POSITION_SOL=5
MAX_TOTAL_EXPOSURE_SOL=15
GAS_RESERVE_SOL=1.5
STOP_LOSS_PCT=15
MAX_TX_PER_DAY=120
PIN_ROTATE_MIN_AGE_MIN=60

# pace
CYCLE_INTERVAL_SEC=300
SCREEN_INTERVAL_SEC=1800

# hedging stays off until Backpack keys exist
HEDGE_LIVE=false

# the sites: the live desk publishes its own journal, at most every 30 minutes
AUTO_DEPLOY=true
AUTO_DEPLOY_MIN_MINUTES=30
SERVE_PORT=3101
