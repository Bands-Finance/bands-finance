# Mr Bands LIVE, sized for the first 20 SOL (2026-09-17). Non-secret; the wallet key stays in .env.
# Loaded by ops/com.bands.mrbands.live.plist and by `npm run live:preflight` / `npm run live:rehearse`.
# DRY_RUN is deliberately NOT here: the live service sets it, and only when Zach says go.

DATA_DIR=data-mainnet
PAPER_SOL=0
PAPER_USDC=0
POLICY_LIVE=true

# the book: Meteora stock pools that already trade, plus the NVDA pairing; no pools of our own, no memecoins
# the book (Zach, 2026-09-17 12:30Z: "lets just enter memecoin style pools"): the board's best, memecoins included
BOOK=all
METEORA_STOCKS=false
METEORA_STOCK_MAX_POOLS=2
# depth and volume floors are sanity only: the seat-yield ranking decides (DKNG/SOL: $2.1M a day on $8k of depth)
METEORA_STOCK_MIN_TVL_USD=5000
POLICY_MIN_VOLUME_24H_USD=250000
# no pin: the book follows the yield ranking (the NVDA pairing was for the hackathon story, not the money)
PAIR_STOCK_PINNED_TICKERS=
# a seat is worth taking at 1% a day on itself (src/screener/seatYield.ts); a held seat under that makes way for one 2x better
METEORA_STOCK_MIN_SEAT_YIELD_PCT=1
METEORA_STOCK_ROTATE_FACTOR=3
METEORA_STOCK_RANK_TOP=8
POLICY_MIN_SEAT_YIELD_PCT=2
# band width follows the token's own measured travel (the scout's last hour of swaps): 0.75x of it, up to
# 25% each way. Zach (2026-09-17): "thats where the money always is. Its in stable price action" (baton was
# laid 5 bins wide under the old 4% cap and priced out in minutes on a token moving 24 bins an hour)
POLICY_VOL_MULTIPLE=0.75
POLICY_MAX_COVER_PCT=25
# a board pool is seated on the flow scout's own reading of it, never on the venue's day figure; a held
# seat whose measured flow reads under half the floor for three cycles comes off (SEAT_FADE_FACTOR, SEAT_FADE_CYCLES)
POLICY_REQUIRE_FLOW=true
SEAT_FADE_FACTOR=0.5
SEAT_FADE_CYCLES=3
PAIR_STOCK_LANE=false
PAIR_LANE=false
LAUNCH_LANE=false
# memecoin floors: not on launch (3 days old with 3 days of candles), at least $1M of market cap
MEME_MIN_AGE_HOURS=72
MEME_MIN_HISTORY_DAYS=3
MEME_MIN_MARKET_CAP_USD=1000000
TRADABLE_VENUES=meteora-dlmm
LIVE_VENUES=meteora-dlmm
SWAP_DEXES="Meteora DLMM"

# size: 20 SOL in the wallet -> 15 at work as two memecoin seats of 7.5 (one token gapping cannot take
# the whole book; the 15% stop is per band), 1.5 kept for gas and rent
MAX_ACTIVE_POOLS=2
MAX_POSITION_SOL=7.5
MAX_TOTAL_EXPOSURE_SOL=15
GAS_RESERVE_SOL=1.5
STOP_LOSS_PCT=15
MAX_TX_PER_DAY=120
PIN_ROTATE_MIN_AGE_MIN=60

# pace
CYCLE_INTERVAL_SEC=300
SCREEN_INTERVAL_SEC=1800

# hedging stays off until Backpack keys exist
HEDGE_LIVE=false

# the sites: the live desk publishes its own journal, at most every 30 minutes
AUTO_DEPLOY=true
AUTO_DEPLOY_MIN_MINUTES=30
SERVE_PORT=3101

# the operator's exit list: the two stock seats come off (closed and liquidated) one per cycle, then the money seats memecoin pools
ROTATE_OUT_POOLS=FCn5zw4gAcfRpQgst5ThFuzBGXbbJ6RocVErgC4vJ9j1,GCBkkA6FUvTiJZjwRBMZoyzHvd9H24uq8F59idhZsvb
