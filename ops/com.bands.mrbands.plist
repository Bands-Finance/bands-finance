<?xml version="1.0" encoding="UTF-8"?>
<!-- Mr Bands as a launchd job on the Mac. Install:
       cp ops/com.bands.mrbands.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.bands.mrbands.plist
     Stop: launchctl unload ~/Library/LaunchAgents/com.bands.mrbands.plist
     Logs: data/mrbands.log. The loop reads .env from the working directory. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.bands.mrbands</string>
  <key>WorkingDirectory</key><string>/Users/zach/Bands.Finance/mr-bands</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/npm</string>
    <string>run</string>
    <string>live</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>/Users/zach/Bands.Finance/mr-bands/data/mrbands.log</string>
  <key>StandardErrorPath</key><string>/Users/zach/Bands.Finance/mr-bands/data/mrbands.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/usr/bin:/bin</string>
    <key>SERVE_PORT</key><string>3000</string>
  </dict>
</dict>
</plist>
